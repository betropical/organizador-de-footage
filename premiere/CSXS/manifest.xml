<?xml version="1.0" encoding="UTF-8"?>
<!-- Organizador de Footage (Premiere) — @betoviedo
     Premiere Pro CC 2018 (12.0) en adelante. CEP 8+ con Node.js para leer los archivos. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.betoviedo.organizadorfootage" ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="Organizador de Footage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.betoviedo.organizadorfootage.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[12.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="8.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.betoviedo.organizadorfootage.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Organizador de Footage</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>360</Width></Size>
            <MinSize><Height>360</Height><Width>280</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
